# ============================================================
# ArepasERP — Backend ENV de ejemplo
# ============================================================
# Copia este archivo como `backend/.env` y completa los valores.
# El .env real NUNCA debe subirse al repo.
# ============================================================

# ── Base de datos PostgreSQL ──────────────────────────────────
DB_USER=app_arepaserp
DB_PASS=CAMBIAR_POR_PASSWORD_FUERTE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ArepasERP
# Modo SSL para la conexión. Opciones: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=prefer

# ── Seguridad ─────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CAMBIAR_GENERAR_CON_secrets.token_hex_64

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS — dominios permitidos (HTTPS únicamente) ─────────────
# Lista separada por comas. NO usar "*" en producción.
ALLOWED_ORIGINS=https://localhost:8444,https://127.0.0.1:8444

# ── Modo debug ────────────────────────────────────────────────
# true habilita /docs, /redoc, /openapi.json y desactiva HSTS
DEBUG=false
